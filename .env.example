# Copia este archivo, nómbralo ".env" y pon tus datos.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore): ahí va tu contraseña.

# Dirección de la base de datos Postgres (Supabase, Neon o local).
# En Supabase: botón "Connect" del proyecto -> "Session pooler" -> copia la dirección
# y cambia [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU-CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Modelo para convertir texto en vectores (embeddings).
# Si lo cambias hay que volver a cargar los fragmentos con --recrear, y el backend debe
# usar exactamente el mismo modelo para las preguntas.
#   Local (corre en tu computadora, sin claves):
MODELO_EMBEDDINGS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   Gemini (API de Google): quita el "#" de estas dos líneas y pon "#" a la de arriba.
# MODELO_EMBEDDINGS=gemini-embedding-001
# DIMENSIONES_EMBEDDINGS=768

# Modelo que redacta las respuestas del chat. El proveedor se elige por el nombre:
#   empieza con "gemini"  -> Gemini (necesita GEMINI_API_KEY)
#   cualquier otro        -> Groq   (necesita GROQ_API_KEY), ej. openai/gpt-oss-120b
MODELO_CHAT=openai/gpt-oss-120b
# Cuánto "piensa" antes de responder: low | medium | high (Gemini acepta además minimal/ninguno).
NIVEL_RAZONAMIENTO=medium
# Azar al redactar (sólo Groq): vacío = el del proveedor (1). Más bajo = respuestas más
# parecidas entre sí, no más cortas. Prueba 0.4 a 0.6; evita 0 con GPT-OSS.
TEMPERATURA_CHAT=

# Clave de Groq (https://console.groq.com/keys). Gratis con límites por día.
GROQ_API_KEY=TU-CLAVE-DE-GROQ

# Clave de Gemini (https://aistudio.google.com -> Get API key). Sólo si usas Gemini para el
# chat o para los embeddings.
GEMINI_API_KEY=TU-CLAVE-DE-GEMINI
