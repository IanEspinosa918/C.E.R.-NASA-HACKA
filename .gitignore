# Datos descargados (pesan GB; cada quien los descarga con scripts/descargar_psi.py)
data/raw/*
!data/raw/.gitkeep

# Reportes (se regeneran con cada corrida)
data/reportes/*
!data/reportes/.gitkeep

# data/processed/ SÍ se sube: son CSV limpios y pequeños que necesita el backend.
# Excepto los fragmentos de texto: pesan varios MB, se regeneran con
# scripts/preparar_textos.py y el equipo los comparte en la base de datos.
data/processed/fragmentos.jsonl

# Claves y configuración local (NUNCA subir claves de API)
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Node / frontend
node_modules/
dist/
build/
.next/

# Sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
